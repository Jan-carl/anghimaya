# --- Ang Himaya API ---
PORT=5000
HOST=0.0.0.0

# Pinapayagang origins para sa CORS (comma-separated).
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Absolute na base URL na ginagamit sa mga URL na ibinibigay ng API (hal. uploads).
PUBLIC_URL=http://localhost:5000

# --- Tanggapan ng Patnugutan (portal.html) ---
PORTAL_PASSCODE=himaya2026
PORTAL_EMAILS=puplopezanghimaya@gmail.com
PORTAL_SECRET=palitan-mo-ito-sa-production
PORTAL_TOKEN_TTL=43200

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# --- Supabase (opsyonal) ---
# Iwan lamang ang lokal na JSON store kung walang URL at server Secret key.
# Project Settings → API Keys: URL + Secret key (sb_secret_...) o legacy service_role JWT.
# Ang privileged key ay para lamang sa server/.env — huwag ilagay sa client/ o portal/.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public

# --- Cloudinary (opsyonal) ---
# Kapag naka-set ang tatlo, mapupunta sa Cloudinary ang POST /api/upload.
# Kapag wala o kapag nabigo, lokal na disk (UPLOAD_DIR) ang gagamitin.
# Console → Copy API Key / API Secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ang-himaya